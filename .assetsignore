# Lo que NO se publica en clicketerno.com.ar.
# Cloudflare sube TODO lo que está en la carpeta del repo: sin este archivo,
# cualquiera podía bajarse sql/claves.sql desde la web.
sql/
pruebas/
apps-script/
# Solo tiene el LEEME de cómo entra una invitación nueva. Va acá además
# de por el *.md: "invitaciones" es un nombre reservado de la app, y la
# prueba saca de este archivo qué carpetas NO son una invitación.
invitaciones/
*.md
wrangler.json
.assetsignore
# El flyer del listado: es la FUENTE de un archivo que se manda por
# WhatsApp, no una página del sitio. Se arma con flyer/armar.sh.
flyer/
video/
*.mp4
ads/
